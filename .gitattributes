# Skrypty i pliki konfiguracyjne kiosku trafiaja na Linuksa i MUSZA miec
# zakonczenia linii LF. Przy CRLF bash konczy bledem "bad interpreter: ^M",
# a wiekszosc demonow po prostu ignoruje takie wpisy.
*.sh        text eol=lf
kiosk/files/*   text eol=lf
*.conf      text eol=lf
*.service   text eol=lf

# Pliki dzwiekowe sa binarne - git NIE MOZE ich normalizowac, bo zamiana
# bajtow 0x0A/0x0D w danych PCM uszkodzilaby dzwiek.
*.wav binary
*.mp3 binary
*.ogg binary
*.png binary
